-- =============================================================================
-- The drone probes with a CAPSULE the width of its own hull, not a hairline
-- ray, and it brakes as well as steers -- steering alone cannot stop a 9 m/s
-- drone that has already committed to a wall.

Config.ObstacleAvoidance = {
    checkDistance = 18.0,    -- maximum probe distance
    minLookahead = 7.0,      -- minimum probe distance, even at a standstill
    lookaheadTime = 1.8,     -- seconds of travel probed ahead (look-ahead scales with speed)
    hullPadding = 1.2,       -- metres added to the model's own radius, so it clears corners rather than grazing them
    probeCount = 8,          -- horizontal directions sampled when searching for a way around
    probePitches = { 0.0, 0.5, -0.3 }, -- radians; level, climbing, descending
    updateInterval = 100,    -- ms between obstacle probes (per drone). Shape tests are the most expensive thing here.
    surfaceProbeDepth = 220.0, -- how far down to look for the ground/roof beneath the drone

    avoidanceStrength = 6.0, -- how strongly avoidance steers vs the desired path
    pushWeight = 1.4,        -- weight of "push straight off the surface"
    slideWeight = 1.0,       -- weight of "slide along the surface" (set to 0 to only ever back away)
    escapeWeight = 1.6,      -- weight of the searched way-around direction
    wallSlide = true,

    escapeSearchFraction = 0.7, -- run the way-around search once an obstacle is inside this fraction of the look-ahead
    headingBias = 0.5,       -- how much a candidate direction is rewarded for pointing where we wanted to go
    climbBias = 0.35,        -- how much upward candidates are preferred (up is almost always the way out of a city)

