-- =============================================================================
-- DRONE ENTITY
-- =============================================================================
-- The drone is a genuine GTA PED (CreatePed), not an object/prop. Since peds
-- have no native "flight" task, we simulate flight by disabling the ped's
-- gravity/ragdoll response and driving its position with our own velocity
-- integrator (see client/movement.lua). Everything related to shooting is
-- still handled by real ped weapon natives (GiveWeaponToPed, TaskShootAtEntity,
-- TaskCombatPed) so damage/ammo/impacts are all genuine GTA weapon damage,
-- never simulated.

-- =============================================================================
-- FLIGHT MODE
-- =============================================================================
-- 'piloted' -- The drone is the add-on VEHICLE with a hidden ped pilot sitting
--              in the driver seat. The vehicle is what flies and what takes
--              damage, and it fires the model's own VEHICLE weapon. Needs
--              droneweapons.meta loaded (vl_drone_model does this).
--
-- 'shell'   -- The drone is a PED that flies and fires a ped weapon, with the
--              vehicle model attached to it as purely cosmetic bodywork.
--
-- Both modes share the same detection / targeting / state machine / patrol AI;
-- only the entity being flown and the way it shoots differ.
Config.FlightMode = 'piloted'

Config.Piloted = {
    vehicleWeapon = `VEHICLE_WEAPON_DRONE`, -- from the add-on's droneweapons.meta
    hidePilot = true,      -- hide the ped in the driver seat so it reads as unmanned
    holdHoverNozzle = true, -- VTOL models (this one is Hydra-based) must be held in hover mode
    keepLevel = true,      -- lock pitch/roll to 0 so the drone hovers flat instead of tumbling
}

-- The ped model used for the pilot / the flying ped, depending on mode.
-- Do NOT put a vehicle model here -- CreatePed only accepts ped models.
-- The drone's LOOK comes from Config.Visual.model below.
Config.DroneModel = `mp_m_freemode_01`

-- =============================================================================
