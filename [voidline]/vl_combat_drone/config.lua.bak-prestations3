-- =============================================================================
-- WARNING / CHALLENGE
-- =============================================================================
-- The drone challenges before it kills: on spotting a player it holds fire,
-- shadows them at standoff range with its alert sounding, and puts a countdown
-- on THAT player's screen. Only when the countdown expires does it open fire.
--
-- The countdown clock lives on the SERVER (see server.lua), because the drone's
-- AI can migrate between clients mid-countdown and a client-side timer would
-- silently restart every time it did.

Config.Warning = {
    enabled = true,

    duration = 12000,  -- ms the player gets to clear the area
    message = 'LEAVE THE AREA OR YOU WILL BE ELIMINATED',
    subMessage = 'TARGET LOCKED — COMPLIANCE REQUIRED',
    tag = 'AUTOMATED DEFENCE DRONE',

    -- Shown the instant the countdown runs out and the drone opens fire, so the
    -- transition reads as the drone committing rather than the HUD just
    -- disappearing at zero.
    expiredMessage = 'ELIMINATION AUTHORIZED',
    expiredSubMessage = 'ENGAGING',                    -- shown when the drone does it itself
    expiredStrikeSubMessage = 'MISSILE STRIKE INBOUND', -- shown when Config.Strike is what answers
    expiredDisplayMs = 3400,

    -- Getting this far from the drone cancels the warning and the drone stands
    -- down. Deliberately smaller than Detection.radius so that walking away
    -- actually works instead of merely staying "seen but distant".
    clearRadius = 55.0,

    -- Once a countdown expires, that player is flagged: every drone engages
    -- them on sight with no second warning until the flag lapses. Without this
    -- a player could farm warnings forever by stepping in and out of range.
    flagDuration = 90000,

    heartbeatInterval = 1000, -- ms between "still warning them" pings to the server
    staleTimeout = 3000,      -- ms without a ping before the server tears the warning down

    -- Extra ms the CONTROLLING client waits past `duration` before deciding the
    -- countdown expired on its own. The server normally declares the expiry
    -- first (so the on-screen countdown reaches zero exactly as the drone opens
    -- fire); this is the safety net that keeps the drone able to shoot even if
    -- the server relay or the NUI page is broken. See Warning.Evaluate.
    localGrace = 1500,

    -- How the drone flies while warning: a slow menacing orbit, weapons cold.
    standoffDistance = 13.0,
    hoverHeightOffset = 7.0,
    orbitSpeed = 0.35,   -- radians/sec
    speedFactor = 0.85,  -- fraction of Movement.maxSpeed used while shadowing
}

-- =============================================================================
-- AIRSTRIKE (what happens when the countdown expires)
-- =============================================================================
-- The drone is the spotter, not the executioner. When the countdown runs out it
-- breaks off and leaves, and missiles come down on the target from the sky.
--
-- Set enabled = false to go back to the drone gunning the target down itself
-- with its own weapon instead (it will ENGAGE rather than WITHDRAW).

Config.Strike = {
    enabled = true,

    count = 5,             -- missiles per salvo
    interval = 750,        -- ms between missiles
    -- ms after the countdown expires before the first missile is committed.
    -- Must be comfortably longer than the drone needs to clear its own blast
    -- radius -- it is withdrawing at Movement.maxSpeed while this runs.
    delay = 2200,

    spawnHeight = 130.0,   -- metres above the impact point the missiles launch from
    launchJitter = 6.0,    -- horizontal scatter of the launch point, so they don't share one vertical line
    spread = 4.5,          -- metres of scatter around the target for each impact
    speed = 220.0,         -- projectile speed
    damage = 200,

    -- Each missile is aimed when it is FIRED, from the target's position at that
    -- moment, not all at once when the strike is called. Lead stops a straight
    -- sprint being a free escape; keep it well under 1.0 so changing direction
    -- still beats it.
    leadTarget = true,
    leadFactor = 0.55,

    -- The telegraph: how long the ground marker shows before that missile
    -- launches. This is the player's actual reaction window -- lower it to make
    -- the strike harsher, raise it to make it more survivable.
    markerLeadTime = 1000,

    -- How long a player is safe from a repeat salvo. Without this, a flagged
    -- player re-acquired by any drone gets struck again immediately.
    cooldown = 30000,

    -- How the drone leaves. It keeps its siren running while it goes.
    withdrawTime = 9000,    -- ms spent leaving before returning to patrol
    withdrawAltitude = 45.0,-- metres of altitude gained while leaving

    -- Used only if neither rocket asset streams in, so a missing weapon asset
    -- degrades to "the explosion still happens" rather than to nothing at all.
    explosionFallback = true,
    explosionType = 4,      -- EXP_TAG_ROCKET
    explosionScale = 1.0,
    cameraShake = 1.0,

    weapon = `WEAPON_AIRSTRIKE_ROCKET`,
    fallbackWeapon = `WEAPON_VEHICLE_ROCKET`,

    marker = {
        enabled = true,
        drawDistance = 150.0, -- don't bother drawing telegraphs further away than this
        startRadius = 6.0,    -- the ring closes in as impact approaches
        endRadius = 1.6,
        height = 1.9,
        slowBlinkHz = 2.0,    -- flashing accelerates toward impact
        fastBlinkHz = 9.0,
        alphaOn = 170,
        alphaOff = 45,
        color = { r = 255, g = 40, b = 20 },
    },
}

